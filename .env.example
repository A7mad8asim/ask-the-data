# Copy to .env and adjust. Every setting has a sensible default.

# Which model writes the SQL: ollama (local, default) | anthropic (Claude API) | oracle (gold SQL, for testing)
LLM_PROVIDER=ollama
# Defaults: qwen3:8b for ollama, claude-opus-5-5 for anthropic
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Claude API (only when LLM_PROVIDER=anthropic). Or run `ant auth login` instead of setting a key.
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium

# Few-shot example retrieval: tfidf (no download) | bge-m3 (via Ollama: `ollama pull bge-m3`)
EMBEDDINGS=tfidf
FEW_SHOT_K=4

# Guardrails
MAX_REPAIRS=2
QUERY_TIMEOUT_S=10
MAX_ROWS=500
MIN_GROUP_SIZE=10

DATA_DIR=./data
